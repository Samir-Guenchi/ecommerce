# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=algerie_post_ecom

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Configuration (for order notifications and verification)
# For Gmail: Use App Password (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
# REQUIRED: Enable 2-Factor Authentication first
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password-here
EMAIL_FROM=Algerie Poste <noreply@algerieposte.dz>

# OAuth Configuration
# ⚠️ IMPORTANT: Replace placeholder values below with real credentials
# See QUICK_OAUTH_SETUP.md for step-by-step instructions (15 minutes)

# Google OAuth - Get credentials at: https://console.cloud.google.com/
# 1. Create project → Enable Google+ API → Create OAuth client ID
# 2. Add redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Facebook OAuth - Get credentials at: https://developers.facebook.com/
# 1. Create app → Add Facebook Login product
# 2. Add redirect URI: http://localhost:3000/api/auth/facebook/callback
FACEBOOK_APP_ID=your-facebook-app-id-here
FACEBOOK_APP_SECRET=your-facebook-app-secret-here
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# Session Secret
SESSION_SECRET=your-session-secret-change-in-production

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:8081
